# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Rust / Tauri ----
target/
**/*.rs.bk
*.pdb

# Tauri build output and generated schemas
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/

# Sidecar binaries are vendored at build time, never committed.
# See src-tauri/binaries/README.md
src-tauri/binaries/*
!src-tauri/binaries/README.md
!src-tauri/binaries/.gitkeep

# ---- Models ----
# GGUF weights, Whisper models, and TTS voices are downloaded at runtime
# into the app data directory. They must never enter the repo.
models/
*.gguf
*.onnx
*.bin

# ---- Local databases ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- Test / coverage ----
coverage/
.nyc_output/
*.lcov
