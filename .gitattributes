# Normalize line endings: LF in the repository, native in the working tree.
# Prevents CRLF churn when macOS and Linux support land in Wave 8.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to remain executable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.wav binary
*.mp3 binary
*.gguf binary
*.onnx binary
*.bin binary
*.exe binary
*.dll binary
*.pdf binary

# Generated lockfiles: collapse in diffs, but still tracked.
package-lock.json linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff
